# Copy this file to .env and fill in real values. Never commit .env.

# Connection string from Neon (Dashboard > your project > Connection Details).
# Must include ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Long random string used to sign student/teacher cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=change-me-to-a-long-random-string

PORT=3000
